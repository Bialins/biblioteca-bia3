
{
  "info": {
    "name": "Biblioteca API",
    "description": "Coleção de requisições para testar a API de gerenciamento de livros.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Autenticação - Gerar Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"SEU_USUARIO\",\n  \"password\": \"SUA_SENHA\"\n}"
        },
        "url": "http://127.0.0.1:8000/api/token/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    pm.collectionVariables.set('access_token', pm.response.json().access);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Listar Livros - GET",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "http://127.0.0.1:8000/api/v1/livros"
      }
    },
    {
      "name": "Cadastrar Livro - POST",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Livro de Exemplo\",\n  \"isbn\": \"9781234567890\",\n  \"autor_id\": \"UUID_DO_AUTOR\",\n  \"categoria_id\": \"UUID_DA_CATEGORIA\"\n}"
        },
        "url": "http://127.0.0.1:8000/api/v1/livros"
      }
    }
  ],
  "variable": [
    {
      "key": "access_token",
      "value": ""
    }
  ]
}
